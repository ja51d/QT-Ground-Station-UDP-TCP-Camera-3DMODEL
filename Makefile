####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/GSS/bin || mkdir -p $(INSTALL_ROOT)/opt/GSS/bin
	$(DEL_FILE) -r $(INSTALL_ROOT)/opt/GSS/bin/GSS.app
	
	$(QINSTALL) GSS.app $(INSTALL_ROOT)/opt/GSS/bin/GSS.app
	-$(STRIP) $(INSTALL_ROOT)/opt/GSS/bin/GSS.app/Contents/MacOS/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/opt/GSS/bin/GSS.app
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/GSS/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

